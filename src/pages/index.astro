---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import getPostsByTag from "@/utils/getPostsByTag";
import { getPath } from "@/utils/getPath";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";
import { HERO, TOPICS, SERIES } from "@/homepage";

// The hero diagram. Swap this import and HERO.diagram in src/homepage.ts together.
import HeroDiagram from "@/assets/images/vector-filter-cliff/02-fill-rate-cliff.svg";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

// Topic tiles, with live post counts. Empty topics are dropped.
const topics = TOPICS.map(topic => ({
  ...topic,
  count: getPostsByTag(posts, topic.tag).length,
})).filter(topic => topic.count > 0);

// Series, resolved against published posts only.
const postsById = new Map(sortedPosts.map(post => [post.id, post]));
const series = SERIES.map(entry => ({
  ...entry,
  parts: entry.posts
    .map(id => postsById.get(id))
    .filter((post): post is NonNullable<typeof post> => Boolean(post)),
})).filter(entry => entry.parts.length > 0);

// Titles already carry a "(Part N)" suffix, which the series list repeats.
const stripPartSuffix = (title: string) =>
  title.replace(/\s*\(part\s*\d+\)\s*$/i, "");
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <section id="hero" class="border-b border-border pt-8 pb-8">
      <p
        class="text-sm font-semibold tracking-[0.2em] text-accent uppercase opacity-80"
      >
        {HERO.kicker}
      </p>
      <div class="mt-3 flex items-start gap-3">
        <h1 class="text-4xl font-bold sm:text-5xl">{HERO.headline}</h1>
        <a
          target="_blank"
          href="/rss.xml"
          class="mt-2 shrink-0"
          aria-label="rss feed"
          title="RSS Feed"
        >
          <IconRss
            width={20}
            height={20}
            class="scale-125 stroke-accent stroke-3 rtl:-rotate-90"
          />
          <span class="sr-only">RSS Feed</span>
        </a>
      </div>
      <p class="mt-4 max-w-2xl text-lg">{HERO.standfirst}</p>
      <p class="mt-2 max-w-2xl opacity-80">{HERO.aside}</p>

      <figure class="mt-8">
        <a href={HERO.diagram.href} class="block">
          <HeroDiagram
            class="h-auto w-full rounded-lg border border-border"
            aria-hidden="true"
          />
        </a>
        <figcaption class="mt-2 text-sm opacity-70">
          <a
            href={HERO.diagram.href}
            class="decoration-dashed underline-offset-4 hover:text-accent hover:underline"
          >
            {HERO.diagram.caption}
          </a>
        </figcaption>
      </figure>

      {
        topics.length > 0 && (
          <nav aria-label="Topics" class="mt-8">
            <ul class="grid grid-cols-2 gap-3 sm:grid-cols-4">
              {topics.map(topic => (
                <li>
                  <a
                    href={`/tags/${topic.tag}/`}
                    class="flex items-baseline justify-between rounded-lg border border-border px-4 py-3 hover:border-accent hover:text-accent"
                  >
                    <span class="font-medium">{topic.label}</span>
                    <span class="text-sm opacity-60">{topic.count}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }

      {
        SOCIALS.length > 0 && (
          <div class="mt-8 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">Social Links:</div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      series.length > 0 && (
        <section id="series" class="border-b border-border pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">Series</h2>
          <ul>
            {series.map(entry => (
              <li class="my-6 rounded-lg border border-border p-5">
                <h3 class="text-lg font-medium">{entry.title}</h3>
                <p class="mt-1 opacity-80">{entry.description}</p>
                <ol class="mt-3 flex flex-wrap gap-x-5 gap-y-2">
                  {entry.parts.map((part, index) => (
                    <li>
                      <a
                        href={getPath(part.id, part.filePath)}
                        class="text-accent decoration-dashed underline-offset-4 hover:underline"
                      >
                        <span class="opacity-60">Part {index + 1}:</span>{" "}
                        {stripPartSuffix(part.data.title)}
                      </a>
                    </li>
                  ))}
                </ol>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-b border-border": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">Featured</h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">Recent Posts</h2>
          <ul>
            {recentPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} />
            )}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href="/posts/">
        All Posts
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
